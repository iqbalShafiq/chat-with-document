# LLM provider (required for chat)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Mistral (required for OCR + embeddings)
MISTRAL_API_KEY=

# Langfuse observability (optional)
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:15433/postgres

# Redis (BullMQ)
REDIS_URL=redis://localhost:16379

# Qdrant vector store
QDRANT_URL=http://localhost:16333
QDRANT_COLLECTION=document_page_chunks

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# API
PORT=3001
NODE_ENV=development

# Auth (Better Auth)
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
PLATFORM_ORIGIN=http://localhost:3000

# User profiling (personalization)
PROFILE_ENABLED=true
PROFILE_REFRESH_DELAY_MINUTES=15
PROFILE_WORKER_CONCURRENCY=3
PROFILE_SUMMARY_MODEL=gpt-5.6-luna
