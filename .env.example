# LLM provider (required for chat)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=

# Mistral (required for OCR + embeddings)
MISTRAL_API_KEY=

# Langfuse observability (optional)
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Web search (Tavily — required for web_search/web_fetch tools)
TAVILY_API_KEY=
# Context7 MCP (optional — library/API docs; free key at https://context7.com/dashboard)
CONTEXT7_API_KEY=
CONTEXT7_URL=https://mcp.context7.com/mcp

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:15433/postgres

# Redis (BullMQ)
REDIS_URL=redis://localhost:16379

# Qdrant vector store
QDRANT_URL=http://localhost:16333
QDRANT_COLLECTION=document_page_chunks

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# API
PORT=3001
NODE_ENV=development

# Auth (Better Auth)
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
PLATFORM_ORIGIN=http://localhost:3000
# Extra browser / mobile-webview origins (comma-separated). PLATFORM_ORIGIN
# and this API origin are always trusted. Native apps typically send no Origin.
# Example: http://localhost:8081,exp://192.168.1.10:8081,myapp://
# In local dev, http://<lan-ip>:3000 and :3001 are trusted automatically.
TRUSTED_ORIGINS=

# Bind address for the API (default 0.0.0.0 = localhost + LAN). Use 127.0.0.1
# to stay machine-local.
# HOST=0.0.0.0

# Optional override for the web app's API URL. Default: same hostname as the
# page, port 3001 (so a phone at http://192.168.x.x:3000 talks to :3001).
# VITE_API_BASE=http://192.168.1.24:3001

# User profiling (personalization)
PROFILE_ENABLED=true
PROFILE_REFRESH_DELAY_MINUTES=15
PROFILE_WORKER_CONCURRENCY=3
PROFILE_SUMMARY_MODEL=openai/gpt-5.6-luna

# Vision helper: vision-capable chat model used by the view_image tool so
# text-only models (e.g. DeepSeek) can "see" conversation images. Leave unset
# to auto-pick the cheapest active vision chat model.
# VISION_HELPER_MODEL=openai/gpt-5-nano

# Agent behavior evals (packages/agent/src/evals)
EVAL_MODEL=deepseek/deepseek-v4-flash-0731
EVAL_MODEL_EFFORT=max
EVAL_JUDGE_MODEL=openai/gpt-5.6-luna
EVAL_JUDGE_EFFORT=high
EVAL_CONCURRENCY=2
EVAL_TIMEOUT_MS=120000

