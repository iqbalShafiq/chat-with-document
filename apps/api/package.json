{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "pnpm with-env node --import tsx --watch src/index.ts",
    "worker:dev": "pnpm with-env node --import tsx --watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker:start": "node dist/worker.js",
    "db:migrate": "pnpm with-env prisma migrate dev",
    "db:studio": "pnpm with-env prisma studio",
    "db:generate": "pnpm with-env prisma generate",
    "db:deploy": "pnpm with-env prisma migrate deploy",
    "db:seed": "pnpm with-env tsx prisma/seed.ts",
    "smoke:auth": "pnpm with-env tsx scripts/smoke-auth.ts",
    "test": "vitest run",
    "with-env": "dotenv -e ../../.env -- "
  },
  "dependencies": {
    "@anvia/core": "^0.16.0",
    "@anvia/memory-prisma": "^0.2.4",
    "@anvia/server": "^0.5.14",
    "@assingment/agent": "workspace:*",
    "@aws-sdk/client-s3": "^3.888.0",
    "@better-auth/prisma-adapter": "^1.6.25",
    "@hono/node-server": "^2.0.11",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "better-auth": "^1.6.25",
    "bullmq": "^5.58.5",
    "hono": "^4.12.32",
    "ioredis": "^5.7.0",
    "prisma": "^7.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}